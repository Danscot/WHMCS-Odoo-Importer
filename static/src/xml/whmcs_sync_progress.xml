<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="whmcs_odoo_import.WhmcsSyncProgress">
        <div class="o_whmcs_sync_progress d-flex flex-column align-items-center justify-content-center">
            <div class="o_whmcs_sync_card text-center p-5 shadow-sm rounded">
                <div class="spinner-border mb-4" role="status" aria-label="Synchronizing">
                    <span class="visually-hidden">Synchronizing…</span>
                </div>
                <h3>Synchronizing WHMCS</h3>
                <p class="text-muted mb-0" t-esc="state.phase"/>
                <p class="small text-muted mt-3 mb-0">The synchronization continues in the background.</p>
            </div>
        </div>
    </t>
</templates>
