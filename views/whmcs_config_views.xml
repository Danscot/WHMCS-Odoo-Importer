<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ====== whmcs.import.config ====== -->
    <record id="view_whmcs_import_config_form" model="ir.ui.view">
        <field name="name">whmcs.import.config.form</field>
        <field name="model">whmcs.import.config</field>
        <field name="arch" type="xml">
            <form string="WHMCS Import Configuration">
                <sheet>
                    <div class="oe_title">
                        <h1>WHMCS Import Configuration</h1>
                    </div>

                    <group string="Live API Import Limits">
                        <div class="alert alert-info" role="alert">
                            Live API limits are read from the module <strong>.env</strong> file.
                            Set <strong>WHMCS_API_IMPORT_LIMIT</strong> for the maximum number of
                            clients, invoices and transactions per synchronization, and
                            <strong>WHMCS_API_FETCH_CHUNK</strong> for the number fetched per cron step.
                        </div>
                        <strong>WHMCS_API_IMPORT_LIMIT</strong>
                        <div>
                            <span class="text-muted">Edit .env:</span>
                            <code>WHMCS_API_IMPORT_LIMIT=25</code>
                        </div>
                        <strong>WHMCS_API_FETCH_CHUNK</strong>
                        <div>
                            <span class="text-muted">Edit .env:</span>
                            <code>WHMCS_API_FETCH_CHUNK=10</code>
                        </div>
                    </group>

                    <group string="Live WHMCS Connection">
                        <group>
                            <div class="alert alert-info" role="alert">
                                WHMCS credentials are currently read from the server <strong>.env</strong>.
                                They are intentionally not stored in Odoo yet.
                            </div>
                            <button name="action_test_whmcs_connection" type="object"
                                    class="btn btn-outline-primary"
                                    string="Test WHMCS Connection"
                                    icon="fa-plug"/>
                            <button name="action_sync_now" type="object"
                                    class="btn btn-primary whmcs_sync_now_button"
                                    string="Synchronize Now"
                                    icon="fa-refresh"/>
                        </group>
                        <group>
                            <field name="auto_sync_enabled"/>
                            <field name="sync_interval_days"/>
                            <field name="sync_import_clients"/>
                            <field name="sync_import_invoices"/>
                            <field name="sync_import_transactions"/>
                        </group>
                    </group>

                    <group string="Synchronization Status">
                        <group>
                            <field name="initial_sync_done"/>
                            <field name="last_sync_status"/>
                            <field name="last_sync_at"/>
                            <field name="last_sync_started_at"/>
                        </group>
                        <group>
                            <field name="last_sync_finished_at"/>
                            <field name="last_sync_batch_id"/>
                            <field name="last_sync_error"/>
                        </group>
                    </group>

                    <group string="General">
                        <group>
                            <field name="company_id" readonly="1"/>
                            <field name="default_invoice_journal_id"/>
                            <field name="default_payment_journal_id"/>
                        </group>
                        <group>
                            <field name="default_product_id"/>
                            <field name="default_tax_id"/>
                            <field name="default_currency_id"/>
                        </group>
                    </group>

                    <group string="Contact Matching">
                        <group>
                            <field name="match_by_whmcs_mapping"/>
                            <field name="match_by_vat"/>
                            <field name="match_by_microsoft_id"/>
                        </group>
                        <group>
                            <field name="match_by_email"/>
                            <field name="match_by_phone"/>
                            <field name="match_by_composite"/>
                        </group>
                    </group>

                    <group string="Payment Gateway Mappings">
                        <field name="gateway_mapping_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="gateway_code"/>
                                <field name="journal_id"/>
                                <field name="payment_method_line_id"/>
                                <field name="active"/>
                                <field name="notes"/>
                            </list>
                        </field>
                    </group>

                    <group string="Demo">
                        <field name="demo_mode"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_whmcs_config" model="ir.actions.act_window">
        <field name="name">Configuration</field>
        <field name="res_model">whmcs.import.config</field>
        <field name="view_mode">form</field>
        <field name="target">main</field>
    </record>

    <!-- ====== whmcs.gateway.mapping ====== -->
    <record id="view_whmcs_gateway_mapping_list" model="ir.ui.view">
        <field name="name">whmcs.gateway.mapping.list</field>
        <field name="model">whmcs.gateway.mapping</field>
        <field name="arch" type="xml">
            <list string="Gateway Mappings" editable="top">
                <field name="gateway_code"/>
                <field name="journal_id"/>
                <field name="payment_method_line_id"/>
                <field name="active"/>
                <field name="notes"/>
            </list>
        </field>
    </record>

</odoo>
