# WHMCS connection used by the standalone connector and live Odoo sync.
WHMCS_URL=https://your-whmcs.example.com/
WHMCS_API_IDENTIFIER=replace_me
WHMCS_API_SECRET=replace_me
WHMCS_VERIFY_SSL=true
# Optional legacy authentication:
# WHMCS_API_USERNAME=
# WHMCS_API_PASSWORD=
WHMCS_API_TIMEOUT=10,30

# Live API import controls
WHMCS_API_IMPORT_LIMIT=10
WHMCS_API_FETCH_CHUNK=10
